{
  "rules": {
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "resumes": {
          ".read": "auth != null && auth.uid === $uid",
          "$resumeId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "resumeData": {
              ".validate": "newData.hasChildren(['personalInfo'])"
            },
            "metadata": {
              ".validate": "newData.hasChildren(['title','lastModified'])",
              "createdAt": {
                ".validate": "data.exists() ? newData.val() === data.val() : newData.isNumber()"
              },
              "lastModified": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        }
      }
    },
    "publicResumes": {
      "$uid": {
        "$resumeId": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === null || newData.hasChildren(['resumeData', 'presentation', 'title', 'publishedAt'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "publishedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "aiRateLimits": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    ".read": false,
    ".write": false
  }
}
